{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "blender": {
        "type": "local",
        "command": [
          "uvx",
          "--python",
          "3.11",
          "--from",
          "mcp-for-blender==2.2.0",
          "mcp-for-blender"
        ],
        "environment": {
          "UV_PYTHON_PREFERENCE": "only-managed",
          "BLENDER_HOST": "localhost",
          "BLENDER_PORT": "9876"
        }
      }
    }
  }
}
