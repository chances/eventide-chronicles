{
  "nodeModulesDir": "auto",
  "workspace": [
    "./lib/gxt",
    "./tools/cfg",
    "./tools/thread-graph",
    "./tools/flow-model",
    "./tools/chart"
  ],
  "tasks": {
    "build": "deno run --env-file=.env --allow-env --allow-read --allow-write --allow-run scripts/build.ts",
    "install": "deno task install:skins && deno run --env-file=.env --allow-env --allow-read --allow-write --allow-run scripts/install.ts",
    "install:skins": "deno run --env-file=.env --allow-env --allow-read --allow-write scripts/install-skins.ts",
    "run": "deno run --env-file=.env --allow-env --allow-read --allow-run scripts/run.ts",
    "chart": "deno run --env-file=.env --allow-env --allow-read --allow-write --allow-run tools/chart/main.ts",
    "chart:serve": "deno run --watch --allow-net=127.0.0.1 --allow-read --allow-write --allow-env --allow-run tools/chart/server.ts",
    "extract-skins": "deno run --env-file=.env --allow-env --allow-read --allow-write scripts/extract-skins.ts",
    "import-skin": "deno run --allow-env --allow-read --allow-write scripts/import-skin.ts",
    "slice-sheet": "deno run --allow-env --allow-read --allow-write scripts/slice-sheet.ts",
    "clean": "deno run --allow-write scripts/clean.ts"
  },
  "imports": {
    "@alg/levenshtein": "jsr:@alg/levenshtein@^0.0.6",
    "@cross/image": "jsr:@cross/image@^0.4.3",
    "@lit-labs/ssr": "npm:@lit-labs/ssr@^4.1.0",
    "@nktkas/bmp": "jsr:@nktkas/bmp@^5.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "ajv": "npm:ajv@^8.20.0",
    "compromise": "npm:compromise@^14.19.0",
    "dxtn": "npm:dxtn@^1.0.0",
    "lit-html": "npm:lit-html@^3.3.3",
    "logi.js": "npm:logi.js@^0.1.8",
    "lucide": "npm:lucide@^1.69.0",
    "rw-parser-ng": "npm:rw-parser-ng@^2.3.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "web-tree-sitter": "npm:web-tree-sitter@^0.27.1"
  }
}
