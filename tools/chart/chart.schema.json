{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eventide.local/chart.schema.json",
  "title": "Mission Chart",
  "type": "object",
  "required": [
    "version",
    "mission",
    "globals",
    "marks",
    "states",
    "launchSites",
    "conflicts",
    "traces"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "globals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "accessor", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "accessor": { "type": "string" },
          "kind": { "enum": ["read", "write"] }
        }
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statementText"],
        "additionalProperties": false,
        "properties": {
          "statementText": { "type": "string" },
          "label": { "type": "string" },
          "occurrence": { "type": "integer", "minimum": 1 },
          "orphaned": { "type": "boolean" }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transitions"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["guard", "target"],
              "additionalProperties": false,
              "properties": {
                "guard": { "type": "string" },
                "target": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "launchSites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "thread", "guardLines"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "thread": { "type": "string" },
          "guardLines": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pair", "global", "accesses"],
        "additionalProperties": false,
        "properties": {
          "pair": {
            "enum": ["mission-thread", "thread-thread", "trigger-mission"]
          },
          "global": { "type": "string", "minLength": 1 },
          "accesses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["script", "file", "line", "kind"],
              "additionalProperties": false,
              "properties": {
                "script": { "type": "string", "minLength": 1 },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "kind": { "enum": ["read", "write"] }
              }
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "file", "line", "severity", "states"],
            "additionalProperties": false,
            "properties": {
              "kind": { "const": "reach" },
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "severity": { "enum": ["error", "warning"] },
              "states": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string" }
              }
            }
          },
          {
            "type": "object",
            "required": ["kind", "severity", "expression"],
            "additionalProperties": false,
            "properties": {
              "kind": { "const": "unphrased" },
              "severity": { "enum": ["error", "warning"] },
              "expression": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["script", "lock", "bound", "effects"],
        "additionalProperties": false,
        "properties": {
          "script": { "type": "string", "minLength": 1 },
          "lock": { "enum": ["free", "held"] },
          "bound": { "type": "integer", "minimum": 1 },
          "cut": { "type": "boolean" },
          "effects": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
