{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "run",
        "-A",
        "jsr:@std/http/file-server",
        "docs",
        "--port",
        "4172"
      ],
      "port": 4172
    },
    {
      "name": "docs:agents",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "run",
        "-A",
        "jsr:@std/http/file-server",
        ".agents",
        "--port",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "chart:serve",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "task",
        "chart:serve",
        "--port",
        "8080"
      ],
      "port": 8080
    }
  ]
}
